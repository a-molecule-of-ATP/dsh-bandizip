{
  "name": "@local/bandizip",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Compress, extract, inspect, and verify archives with the local Bandizip console tool.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "node_modules/@deepseek-ai/schemastery",
    "node_modules/@deepseek-ai/cosmokit"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
