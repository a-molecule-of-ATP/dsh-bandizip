{
  "name": "@local/bandizip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin that drives the local Bandizip console tool (bz.exe) to create, extract, list, test, preview, diff, browse and convert archives.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bandizip",
    "archive",
    "zip",
    "7z"
  ],
  "license": "MIT",
  "author": "a-molecule-of-ATP",
  "repository": {
    "type": "git",
    "url": "https://github.com/a-molecule-of-ATP/dsh-bandizip.git"
  },
  "bugs": {
    "url": "https://github.com/a-molecule-of-ATP/dsh-bandizip/issues"
  },
  "homepage": "https://github.com/a-molecule-of-ATP/dsh-bandizip#readme",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/cosmokit": "*"
  },
  "bundledDependencies": [
    "@deepseek-ai/schemastery",
    "@deepseek-ai/cosmokit"
  ]
}
