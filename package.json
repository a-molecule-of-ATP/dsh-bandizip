{
  "name": "@local/bandizip",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin that drives the local Bandizip console tool (bz.exe) to create, extract, list, and test archives.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bandizip",
    "archive",
    "zip",
    "7z"
  ],
  "license": "MIT",
  "author": "dafeiyu",
  "repository": {
    "type": "git",
    "url": "https://github.com/dafeiyu/dsh-bandizip.git"
  },
  "bugs": {
    "url": "https://github.com/dafeiyu/dsh-bandizip/issues"
  },
  "homepage": "https://github.com/dafeiyu/dsh-bandizip#readme",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "node_modules/@deepseek-ai/schemastery",
    "node_modules/@deepseek-ai/cosmokit"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
